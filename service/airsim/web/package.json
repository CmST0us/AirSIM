{
  "name": "airsim-pairing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine": "python3 ../../../module/airsim-agent/scripts/build_web_artifact.py --output public/engine",
    "predev": "npm run engine",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run engine && tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2"
  }
}
