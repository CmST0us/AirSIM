# Controller-selected Shenzhen deployment template; no deployment performed by this chat.
# Non-secret deployment parameters only. Never put tokens/passwords/private keys here.
AIRSIM_PROJECT=airsim-v2
AIRSIM_SECRET_DIR=/srv/airsim-v2/protected
AIRSIM_UID=65532
AIRSIM_GID=65532
AIRSIM_API_ORIGIN=https://airsim.eric3u.cc
AIRSIM_DEVICE_ORIGIN=https://device.airsim.eric3u.cc
AIRSIM_MEDIA_ORIGIN=https://airsim.eric3u.cc
AIRSIM_API_HOST=airsim.eric3u.cc
# Fill after admin init; public server UUID, not a credential.
AIRSIM_SERVER_ID=
# Set the exact local image ID or published repository@sha256 digest after build.
AIRSIM_BUSINESS_IMAGE=
# Optional offline-loaded image overrides: only ECS-verified content-addressed image IDs.
# AIRSIM_CADDY_IMAGE=sha256:<verified-runtime-image-id>
# AIRSIM_POSTGRES_IMAGE=sha256:<verified-runtime-image-id>
